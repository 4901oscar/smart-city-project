#############################
# Email (Gmail SMTP)
#############################
# IMPORTANTE: Para usar Gmail, necesitas generar una "Contraseña de aplicación"
# Tutorial: https://support.google.com/accounts/answer/185833
# 1. Ve a tu cuenta de Google → Seguridad
# 2. Activa "Verificación en 2 pasos"
# 3. Ve a "Contraseñas de aplicaciones"
# 4. Genera una contraseña para "Correo" / "Otro (nombre personalizado)"
# 5. Copia la contraseña de 16 caracteres aquí abajo

EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=smartcity.alerts@gmail.com
EMAIL_USERNAME=oscarrivera4901@gmail.com
EMAIL_PASSWORD=seto npwn misi ceqe
EMAIL_ALERT_RECIPIENT=innovatesavvysolutions@gmail.com

#############################
# Kafka (Confluent Platform 7.4.0)
#############################
# Usar kafka:29092 desde contenedores Docker
# Usar localhost:9092 desde host (js-scripts, testing)

KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Topic principal para todos los eventos
KAFKA_EVENTS_TOPIC=events-topic

#############################
# Backend API (.NET 9)
#############################
# Puerto expuesto en host desde Docker
BACKEND_PORT=5000

# Swagger UI disponible en: http://localhost:5000

#############################
# Testing & Simulación
#############################
# Productores válidos según especificación canónica
# Valores permitidos: artillery | python-sim | kafka-cli | js-sim
PRODUCER_ID=js-sim

# Intervalo de generación de eventos (milisegundos)
EVENT_GENERATION_INTERVAL=3000

# Zonas geográficas configuradas (Universidad)
DEFAULT_ZONE=Zona 10
DEFAULT_LAT=14.6091
DEFAULT_LON=-90.5252

#############################
# Configuración para Docker Local (ALTERNATIVA)
#############################
# Para usar PostgreSQL local en lugar de Neon:
# 1. Descomentar estas líneas
# 2. Descomentar servicio postgres en docker-compose.yml
# 3. Comentar configuración de Neon arriba

# PGHOST=postgres
# PGDATABASE=SmartCitiesBD
# PGUSER=postgres
# PGPASSWORD=supersecretpassword
# PGSSLMODE=disable
# PGCHANNELBINDING=prefer